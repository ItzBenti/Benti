{
  "manifest_version": 3,
  "name": "Benti – KI-Bilder kennzeichnen (EU AI Act)",
  "short_name": "Benti",
  "version": "1.0.0",
  "description": "KI-generierte Bilder gemäß Art. 50 EU AI Act kennzeichnen – sichtbares Label + Metadaten, 100 % lokal im Browser.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Benti öffnen",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "Benti_MVP.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "downloads"
  ],
  "host_permissions": []
}
